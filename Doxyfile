# Doxyfile for generating documentation with Doxygen

# Project related configurations
PROJECT_NAME           = "Your Project Name"
PROJECT_BRIEF          = "A brief description of your project"
PROJECT_LOGO           = "path/to/logo.png"
OUTPUT_DIRECTORY       = "docs"
DOXYFILE_ENCODING      = UTF-8
GENERATE_LATEX         = NO
EXTRACT_ALL            = YES

# Input configurations
INPUT                  = .
FORMAT_SOURCE_FILES    = YES
RECURSIVE             = YES

# Doxygen specific settings
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_XML           = YES
XML_OUTPUT             = xml
